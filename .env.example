# GEMINI_API_KEY: Required for Gemini AI API calls if AI extensions are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key for signing NeuroBloom JWT sessions.
JWT_SECRET="neurobloom-dev-secret-change-in-production"

# DB_PATH: SQLite database file path (modular storage adapter also supports MONGODB_URI).
DB_PATH="./neurobloom.db"
MONGODB_URI=""

# EMAIL_NOTIFICATIONS_MODE: "local" (persisted queue) or "smtp"
EMAIL_NOTIFICATIONS_MODE="local"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
